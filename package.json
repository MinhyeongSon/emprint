{
  "name": "emprint",
  "license": "SEE LICENSE IN LICENSE",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "main": "apps/desktop/out/main/index.cjs",
  "packageManager": "npm@11.12.1",
  "description": "Local-first, Git-native workspace runtime for creators, developers, and AI-native workflows.",
  "author": {
    "name": "Emprint"
  },
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev": "node scripts/run-electron-vite.mjs dev --config electron.vite.config.ts",
    "build": "node scripts/run-electron-vite.mjs build --config electron.vite.config.ts",
    "build:icons": "node scripts/prepare-build-icons.mjs",
    "prepack": "npm run build:icons && npm run build",
    "pack": "electron-builder --dir",
    "predist": "npm run build:icons && npm run build",
    "dist": "electron-builder",
    "predist:mac": "npm run build:icons && npm run build",
    "dist:mac": "electron-builder --mac",
    "predist:win": "npm run build:icons && npm run build",
    "dist:win": "electron-builder --win",
    "predist:linux": "npm run build:icons && npm run build",
    "dist:linux": "electron-builder --linux",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tiptap/extension-color": "^3.23.1",
    "@tiptap/extension-image": "^3.23.1",
    "@tiptap/extension-placeholder": "^3.23.1",
    "@tiptap/extension-text-style": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "simple-git": "^3.27.0",
    "tailwind-merge": "^2.5.4",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^4.5.5"
  },
  "overrides": {
    "tar": "^7.5.15",
    "esbuild": "^0.25.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^40.10.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.1",
    "patch-package": "^8.0.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^6.4.1",
    "vite-plugin-monaco-editor": "^1.1.0"
  }
}
