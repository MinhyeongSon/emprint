{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["./apps/desktop/src/renderer/src/*"],
      "@emprint/shared": ["./shared/src/index.ts"],
      "@emprint/shared/*": ["./shared/src/*"],
      "@emprint/core": ["./core/src/index.ts"],
      "@emprint/core/*": ["./core/src/*"]
    }
  }
}
